# Variables del stack Docker (docker compose --profile app up -d --build).
# Copia este fichero a ".env" (cp env.example .env) y ajusta los valores.
# ".env" esta en .gitignore: no lo subas al repositorio.

# --- OBLIGATORIA -------------------------------------------------------------------------------------------
# Secreto para firmar los JWT (HMAC-SHA256, minimo 32 bytes). El valor de abajo es SOLO UN MARCADOR: sustituyelo.
# Genera uno aleatorio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
VIBORA_JWT_SECRET=CAMBIAME-marcador-de-posicion-genera-uno-con-el-comando-de-arriba

# --- Opcionales (estos son los valores por defecto) ----------------------------------------------------------
# Puerto del host donde se publica la web (nginx). El backend NO se publica.
FRONTEND_PORT=8088

# Base de datos. Si ya tienes un volumen "vibora-pgdata" creado con otras credenciales, no las cambies aqui:
# Postgres solo lee estas variables al inicializar un volumen vacio.
POSTGRES_DB=vibora
POSTGRES_USER=vibora
POSTGRES_PASSWORD=vibora

# Opciones extra para la JVM del backend (p. ej. -Xss512k). Vacio por defecto.
JAVA_OPTS=
